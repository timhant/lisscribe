<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageVersion Include="NAudio.Core" Version="2.3.0" />
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="Avalonia" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.18" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- net10.0-windows 的共享框架里**没有** SystemEvents：不加这个包，Microsoft.Win32.SystemEvents
         会得到 CS1069（类型已转发到该程序集）。SessionMonitor 用它拿锁屏与休眠通知。 -->
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- trx 报告器**不在** Microsoft.Testing.Platform 里，要单独引这个包：不引的话
         report-trx 那个参数（命令行上带两道杠）是未知选项，测试主机在参数解析阶段就退出，
         一条测试也不跑，而 dotnet test 报的是「Tests failed」且不打印任何汇总行
         ——看着像测试红了。CI 的两步测试都带这个参数，2026-07-30 到 08-02 那六次全红都是它。
         注：XML 注释里写不了那两道杠，连续两个连字符是非法 XML。 -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
  </ItemGroup>
</Project>
